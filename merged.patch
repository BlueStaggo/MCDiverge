+public class StructurePlacement {
+    public static final int FLAG_FULL_PLACEMENT = 1 << 0;
+    public static final int FLAG_PLACE_DEV_BLOCKS = 1 << 1;
+    public static final int FLAG_SKIP_BLOCK_MODIFIERS = 1 << 2;
+
+    private final Structure structure;
+    private final int x;
+    private final int y;
+    private final int z;
+    private final int rotation;
+    private final LongSet chunksToPlace;
+    private final List<TileEntity> tileEntitiesToPlace = new ArrayList<>();
+    private final List<JigsawTileEntity> worldJigsaws = new ArrayList<>();
+    private final StructureBlockModifier blockModifier;
+    private int groundLevel = Integer.MIN_VALUE;
+    private boolean isOnGround = false;
+
+    public StructurePlacement(Structure structure, int x, int y, int z, int rotation) {
+        this.structure = structure;
+        this.x = x;
+        this.y = y;
+        this.z = z;
+        this.rotation = rotation &= 3;
+        this.blockModifier = StructureModifierRegistry.getBlockModifierFromStructure(structure);
+
+        this.chunksToPlace = new LongOpenHashSet();
+        for (int xx = 0; xx < this.getWidth(); xx++) {
+            for (int zz = 0; zz < this.getLength(); zz++) {
+                this.chunksToPlace.add(ChunkCoordIntPair.chunkXZ2Int((xx + x + 8) / 16, (zz + z + 8) / 16));
+            }
+        }
