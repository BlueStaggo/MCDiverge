+
+public class LootChoice<T> implements LootEntry<T> {
+	public final LootEntry<T>[] lootEntries;
+	public final float chance;
+
+	@SafeVarargs
+	public LootChoice(LootEntry<T>... lootEntries) {
+		this(1.0F, lootEntries);
+	}
+
+	@SafeVarargs
+	public LootChoice(float chance, LootEntry<T>... lootEntries) {
+		this.chance = chance;
+		this.lootEntries = lootEntries;
+	}
+
+	public ItemStack getItem(T modifier, Random random) {
+		if (random.nextFloat() > this.chance) return null;
+		LootEntry<T> choice = this.lootEntries[random.nextInt(this.lootEntries.length)];
+		return choice.getItem(modifier, random);
+	}
