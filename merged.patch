+        byte[] byteArray = blockArray.data.getArray();
+
+        for (int i = 0; i < nibbleArray.length; i++) {
+            byteArray[i * 2] = (byte)(nibbleArray[i] & 0xF);
+            byteArray[i * 2 + 1] = (byte)((nibbleArray[i] >> 4) & 0xF);
+        }
+
+        return blockArray;
+    }
