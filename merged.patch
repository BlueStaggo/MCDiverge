+
+public abstract class TerrainGenStructure extends TerrainGenerator {
+    private final LongSet genCoords = new LongOpenHashSet();
+    private final List<StructurePlacement> structurePlacements = new ArrayList<>();
+
+    public void generateRecursive(World var1, int var2, int var3, int var4, int var5, Chunk var6) {
+        if (this.generateAt(var1, var2, var3)) {
+            long coord = ChunkCoordIntPair.chunkXZ2Int(var2, var3);
+            if (!genCoords.contains(coord)) {
+                genCoords.add(coord);
+                this.structurePlacements.addAll(this.buildStructure(var2 * 16 + 8, var3 * 16 + 8));
+            }
+        }
+    }
+
+    public void placeStructures(World world, Random random, int cx, int cz) {
+        List<StructurePlacement> structurePlacementsToRemove = null;
+        List<StructurePlacement> structurePlacements = new ArrayList<>(this.structurePlacements);
+        for (StructurePlacement structurePlacement : structurePlacements) {
+            structurePlacement.place(world, random, cx, cz);
+            if (structurePlacement.isCompletelyPlaced()) {
+                if (structurePlacementsToRemove == null) structurePlacementsToRemove = new ArrayList<>();
+                structurePlacementsToRemove.add(structurePlacement);
+            }
+        }
+
+        if (structurePlacementsToRemove != null) {
+            this.structurePlacements.removeAll(structurePlacementsToRemove);
+        }
+    }
+
+    public abstract boolean generateAt(World world, int x, int z);
+
+    public abstract List<StructurePlacement> buildStructure(int x, int z);
+
+    protected boolean generateOnGrid(int x, int z, int gridSize, int gridOffset, long salt) {
+        int gx = Math.floorDiv(x, gridSize) * gridSize;
+        int gz = Math.floorDiv(z, gridSize) * gridSize;
+
+        long saltX = this.rand.nextLong() / 2L * 2L + 1L;
+        long saltZ = this.rand.nextLong() / 2L * 2L + 1L;
+
+        this.rand.setSeed((long)gx * saltX + (long)gz * saltZ ^ this.worldObj.getRandomSeed() ^ salt);
+
+        int ox = this.rand.nextInt(gridOffset + 1);
+        int oz = this.rand.nextInt(gridOffset + 1);
+        return x == gx + ox && z == gz + oz;
+    }
