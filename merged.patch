+package net.minecraft.game.world.drawing;
+
+import net.minecraft.game.world.BlockPos;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+public class MoveOperation implements DrawingOperation {
+    private final BlockPos offset;
+
+    public MoveOperation(int x, int y, int z) {
+        this(new BlockPos(x, y, z));
+    }
+
+    public MoveOperation(BlockPos offset) {
+        this.offset = offset;
+    }
+
+    public String getName() {
+        return "Move";
+    }
+
+    public String[] getCoordinatePrompts() {
+        return TWO_POINTS_PROMPTS;
+    }
+
+    public void draw(DrawingManager.Access draw, BlockPos[] coordinates) {
+        if (this.offset.x == 0 && this.offset.y == 0 && this.offset.z == 0) {
+            return;
+        }
+
+        List<PositionalBlockState> blocks = new ArrayList<>();
+
+        Iterator<BlockPos> sourceArea = new BlockPos.CuboidIterator(coordinates[0], coordinates[1]);
+        while (sourceArea.hasNext()) {
+            BlockPos pos = sourceArea.next();
+            if (draw.getBrushBlock(pos.x, pos.y, pos.z) != null) {
+                blocks.add(new PositionalBlockState(pos, draw.getBlock(pos)));
+            }
+        }
+
+        for (PositionalBlockState block : blocks) {
+            draw.addBlock(block.x, block.y, block.z, 0, 0);
+        }
+        for (PositionalBlockState block : blocks) {
+            draw.addBlock(
+                    block.x + this.offset.x,
+                    block.y + this.offset.y,
+                    block.z + this.offset.z,
+                    block.id,
+                    block.metadata
+            );
+        }
+    }
+}
