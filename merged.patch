+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+public class StringChoiceParameter extends CommandParameter<String> {
+    private final Set<String> choices;
+
+    public StringChoiceParameter(String name, String description, String defaultValue, String... choices) {
+        this(name, description, defaultValue, Arrays.stream(choices).collect(Collectors.toSet()));
+    }
+
+    public StringChoiceParameter(String name, String description, String defaultValue, Set<String> choices) {
+        super(name == null ? String.join("|", choices) : name, description, defaultValue);
+        this.choices = choices;
+    }
+
+    public List<String> getAutocompleteOptions(CommandContext context, String baseArgument, String query) {
+        return choices.stream()
+                .sorted()
+                .collect(Collectors.toList());
+    }
+
+    protected String parse(String input, CommandContext context) throws CommandParseException {
+        if (!this.choices.contains(input)) {
+            throw new CommandParseException("Option \"" + input + "\" not valid. Valid options: "
+                    + this.choices.stream().map(c -> '"' + c + '"').collect(Collectors.joining(", ")));
+        }
+        return input;
+    }
+}
