+		public void print(IntArray2D array, int width, int height) {
+			function.print(array, width, height);
+		}
+
+		public void sequencedPrint(List<Layer> genLayers, int x, int y, int width, int height) {
+			sequencedFunction.print(genLayers, x, y, width, height);
+		}
