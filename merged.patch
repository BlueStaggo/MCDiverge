+	}
+
+	public boolean canInteractWith(PlayerEntity var1) {
+		return true;
+	}
+
+	private static ItemStack parseItemStack(String id) {
+		int hyphenIndex = id.indexOf("-");
+		String[] idSplit = hyphenIndex == -1 ? new String[] { id } : new String[] {
+				id.substring(0, hyphenIndex),
+				id.substring(hyphenIndex + 1)
+		};
+		boolean isBlock = !idSplit[0].startsWith("i");
+		if (!isBlock) {
+			idSplit[0] = idSplit[0].substring(1);
+		}
+
+		int itemID = Integer.parseInt(idSplit[0]);
+		int itemMetadata = idSplit.length == 2 ? Integer.parseInt(idSplit[1]) : 0;
+
+		if (itemID < 0 || Item.fromID(itemID, isBlock) == null) {
+			return null;
+		}
+
+		return new ItemStack(itemID, 1, itemMetadata, isBlock);
+	}
+
+	public static class Label {
+		public final String name;
+		public final ItemStack icon;
+		public final int y;
+
+		public Label(String name, ItemStack icon, int y) {
+			this.name = name;
+			this.icon = icon;
+			this.y = y;
+		}
+	}
+}
