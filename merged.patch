+                                    | (15L << (6 + 6 + 16))
+                                    | (propagateDirection << (6 + 6 + 16 + 4))
+                            // do not set transparent blocks for the same reason we don't in the checkBlock method
+                    );
+
+                    nibble.set(worldX & 15, currY & 15, worldZ & 15, 0);
+                }
+            }
