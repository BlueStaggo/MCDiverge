+        for (TileEntity tileEntity : structure.tileEntities) {
+			CompoundTag compound = new CompoundTag();
+			tileEntity.writeToNBT(compound);
+			TileEntity newTileEntity = TileEntity.createAndLoadEntity(compound, null);
