+    public static List<StructurePlacement> generateComplex(
+            Random random,
+            Map<String, WeightedPool<Structure>> pools,
+            StructurePlacement startingStructure,
+            int size
+    ) {
+        List<AssociatedJigsaw> jigsaws = startingStructure.worldJigsaws.stream()
+                .map(jigsaw -> new AssociatedJigsaw(jigsaw, startingStructure))
+                .collect(Collectors.toCollection(ArrayList::new));
+        List<StructurePlacement> structurePlacements = new ArrayList<>();
+        structurePlacements.add(startingStructure);
+
+        loopJigsaws: while (!jigsaws.isEmpty() && size > 0) {
+            AssociatedJigsaw associatedJigsaw = jigsaws.remove(random.nextInt(jigsaws.size()));
+            JigsawTileEntity jigsaw = associatedJigsaw.jigsaw;
+            StructurePlacement sourceStructurePlacement = associatedJigsaw.structurePlacement;
+
+            String targetPool = jigsaw.to;
+            WeightedPool<Structure> pool = pools.get(targetPool);
+            if (pool == null) {
+                continue;
+            }
+
+            Structure nextStructure = pool.get(random);
+            List<JigsawTileEntity> potentialJigsaws = nextStructure.jigsaws.stream()
+                    .filter(j -> j.from.equals(targetPool))
+                    .collect(Collectors.toList());
+            if (potentialJigsaws.isEmpty()) {
+                continue;
+            }
+
+            JigsawTileEntity nextJigsaw = potentialJigsaws.get(random.nextInt(potentialJigsaws.size()));
+            int nextJigsawIndex = nextStructure.jigsaws.indexOf(nextJigsaw);
+            Direction2D nextDirection = jigsaw.direction.to2D();
+            Direction2D directionToPrev = nextJigsaw.direction.to2D();
+            int nextRotation = nextDirection == null || directionToPrev == null ? random.nextInt(4)
+                    : (nextDirection.getIdNESW() - directionToPrev.getIdNESW() - 2) & 3;
+
+            int targetX = jigsaw.xCoord + jigsaw.direction.x;
+            int targetY = jigsaw.yCoord + jigsaw.direction.y;
+            int targetZ = jigsaw.zCoord + jigsaw.direction.z;
+
+            int nextJigsawLocalX = rotateX(nextJigsaw.xCoord, nextJigsaw.zCoord, nextRotation, nextStructure.width, nextStructure.length);
+            int nextJigsawLocalY = nextJigsaw.yCoord;
+            int nextJigsawLocalZ = rotateZ(nextJigsaw.xCoord, nextJigsaw.zCoord, nextRotation, nextStructure.width, nextStructure.length);
+
+            int nextStructureX = targetX - nextJigsawLocalX;
+            int nextStructureY = targetY - nextJigsawLocalY;
+            int nextStructureZ = targetZ - nextJigsawLocalZ;
+
+            StructurePlacement nextStructurePlacement = new StructurePlacement(nextStructure, nextStructureX, nextStructureY, nextStructureZ, nextRotation);
+            for (StructurePlacement structurePlacement : structurePlacements) {
+                if (structurePlacement != sourceStructurePlacement && structurePlacement.intersects(nextStructurePlacement)) {
+                    if (random.nextInt(3) == 0) {
+                        size--;
+                    } else {
+                        jigsaws.add(associatedJigsaw);
+                    }
+                    continue loopJigsaws;
+                }
+            }
+
+            structurePlacements.add(nextStructurePlacement);
+            for (int i = 0; i < nextStructurePlacement.worldJigsaws.size(); i++) {
+                if (i != nextJigsawIndex) {
+                    jigsaws.add(new AssociatedJigsaw(nextStructurePlacement.worldJigsaws.get(i), nextStructurePlacement));
+                }
+            }
+
+            size--;
+        }
+
+        return structurePlacements;
+    }
+
+    private static class AssociatedJigsaw {
+        public final JigsawTileEntity jigsaw;
+        public final StructurePlacement structurePlacement;
+
+        private AssociatedJigsaw(JigsawTileEntity jigsaw, StructurePlacement structurePlacement) {
+            this.jigsaw = jigsaw;
+            this.structurePlacement = structurePlacement;
+        }
+    }
