+import java.util.TreeMap;
+
+public class WeightedPool<T> {
+    private final NavigableMap<Float, T> map = new TreeMap<>();
+    private final float totalWeight;
+
+    @SafeVarargs
+    public WeightedPool(Entry<T>... entries) {
+        float totalWeight = 0.0F;
+        for (Entry<T> entry : entries) {
+            totalWeight += entry.weight;
+            this.map.put(totalWeight, entry.value);
+        }
+        this.totalWeight = totalWeight;
+    }
+
+    public T get(Random random) {
+        float targetWeight = random.nextFloat() * this.totalWeight;
+        return map.higherEntry(targetWeight).getValue();
+    }
+
+    public static class Entry<T> {
+        public final T value;
+        public final float weight;
+
+        public Entry(T value, float weight) {
+            this.value = value;
+            this.weight = weight;
+        }
+    }
+}
