+
+public class OceanBiome extends Biome {
+	private PerlinNoiseOctaves surfaceNoise1;
+	private PerlinNoiseOctaves surfaceNoise2;
+	private PerlinNoiseOctaves surfaceNoise3;
+
+	public OceanBiome(int i) {
+		super(i);
+		this.topBlock = (byte)Block.sand.blockID;
+		this.fillerBlock = (byte)Block.stone.blockID;
+	}
+
+	protected void initializeNoise(Random random) {
+		this.surfaceNoise1 = new PerlinNoiseOctaves(random, 4);
+		this.surfaceNoise2 = new PerlinNoiseOctaves(random, 4);
+		this.surfaceNoise3 = new PerlinNoiseOctaves(random, 4);
+	}
+
+	protected NoiseSettings.Builder buildNoiseSettings() {
+		return super.buildNoiseSettings()
+				.heightOffset(-16.0D)
+				.noiseStretch(5.0D)
+				.noiseUnderDamp(4.0D)
+				.caveThresholdHigh(1.0D);
+	}
+
+	public NoiseSettings getNoiseSettings(NoiseSettingsModifiers modifiers) {
+		double ocean = Math.max(modifiers.ocean, -1.0D);
+		double height = ocean * 25.0D - 5.0D;
+		if (modifiers.river) {
+			height = Math.min(height, this.riverNoiseSettings.heightOffsetMin());
+		}
+
+		return new NoiseSettings.Builder(super.getNoiseSettings(modifiers))
+				.heightOffset(height)
+				.noiseStretch(35.0D * -ocean + 5.0D)
+				.chasmThresholdHigh(0.0D)
+				.caveThresholdHigh(1.0D)
+				.build();
+	}
+
+	public void buildSurfaceColumn(Chunk chunk, int x, int z, int surfaceHeight, int seaLevel, Random random) {
+		int wx = chunk.xPosition * 16 + x;
+		int wz = chunk.zPosition * 16 + z;
+
+		int gravelOffset = seaLevel + 5 + random.nextInt(3);
+		int block = surfaceHeight < gravelOffset ? (byte)Block.sand.blockID : (byte)Block.stone.blockID;
+
+		if (block == Block.sand.blockID && surfaceHeight < seaLevel - 1) {
+			if (this.surfaceNoise1.generateNoiseNormalized2D(wx * 0.05D, wz * 0.05D) + random.nextDouble() * 0.05D > 0.1D) {
+				block = Block.gravel.blockID;
+			} else if (this.surfaceNoise2.generateNoiseNormalized2D(wx * 0.05D, wz * 0.05D) + random.nextDouble() * 0.05D > 0.1D) {
+				block = Block.dirt.blockID;
+			} else if (this.surfaceNoise3.generateNoiseNormalized2D(wx * 0.2D, wz * 0.2D) + random.nextDouble() * 0.05D > 0.35D) {
+				block = Block.clayBlock.blockID;
+			}
+		}
+
+		this.topBlock = this.fillerBlock = block;
+
+		super.buildSurfaceColumn(chunk, x, z, surfaceHeight, seaLevel, random);
+	}
+
+	public void decorate(PopulatorHost populator) {
+		int quantity = populator.rand.nextInt(5) - populator.rand.nextInt(5);
+		for (int i = 0; i < quantity; i++) {
+			int genX = populator.x + populator.rand.nextInt(16) + 8;
+			int genZ = populator.z + populator.rand.nextInt(16) + 8;
+			int genY = populator.worldObj.findTopSolidBlock(genX, genZ);
+			SeaweedFeature.INSTANCE.generate(populator.worldObj, populator.rand, genX, genY, genZ);
+		}
+		super.decorate(populator);
+	}
+}
