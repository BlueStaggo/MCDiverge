+import net.minecraft.game.world.block.BlockNames;
+import net.minecraft.game.world.block.properties.Property;
+import net.minecraft.game.world.drawing.BlockState;
+
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+public class BlockParameter extends CommandParameter<BlockState> {
+    public BlockParameter(String name, String description, BlockState defaultValue) {
+        super(name, description, defaultValue);
+    }
+
+    public String getAutocompleteQuery(String argument) {
+        int c = argument.indexOf(':');
+        if (c != -1) {
+            c = Math.max(c, argument.lastIndexOf(','));
+            argument = argument.substring(c + 1);
+        }
+        return argument;
+    }
+
+    public List<String> getAutocompleteOptions(CommandContext context, String baseArgument, String query) {
+        int colon = baseArgument.indexOf(':');
+        if (colon == -1) {
+            return BlockNames.getAllNames().stream().sorted().collect(Collectors.toList());
+        }
+
+        BlockState baseBlock = BlockNames.parse(baseArgument.substring(0, colon));
+        if (baseBlock == null || Block.blocksList[baseBlock.id] == null) {
+            return Collections.emptyList();
+        }
+
+        return Block.blocksList[baseBlock.id].properties
+                .getAllProperties().stream()
+                .sorted(Comparator.comparing(Property::getName))
+                .flatMap(p -> {
+                    List<String> properties = p.getValidStrings().stream()
+                            .sorted()
+                            .map(v -> p.getName() + "=" + v)
+                            .collect(Collectors.toList());
+                    if (!properties.isEmpty()) {
+                        return properties.stream();
+                    }
+                    return Stream.of(p.getName() + "=");
+                })
+                .collect(Collectors.toList());
+    }
+
+    protected BlockState parse(String input, CommandContext context) throws CommandParseException {
+        return BlockNames.parse(input);
+    }
+}
