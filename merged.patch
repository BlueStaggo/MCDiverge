+import java.util.Random;
+
+public class LayerZoomPerlin extends Layer {
+    private final double zoom;
+    private final double strength;
+    private final double variation;
+    private PerlinNoise xOffsetNoise;
+    private PerlinNoise zOffsetNoise;
+
+    public LayerZoomPerlin(long seed, Layer parent, double zoom, double strength, double variation) {
+        super(seed, parent);
+        this.zoom = zoom;
+        this.strength = strength;
+        this.variation = variation;
+    }
+
+    public void setWorldSeed(long seed) {
+        super.setWorldSeed(seed);
+        Random random = new Random(this.getWorldSeed());
+		this.xOffsetNoise = new PerlinNoise(random);
+		this.zOffsetNoise = new PerlinNoise(random);
+    }
+
+    protected int getData(int x, int z) {
+        int zx = (int)Math.round((x / this.zoom) + this.xOffsetNoise.generateNoise2D(x * this.variation / this.zoom, z * this.variation / this.zoom) * this.strength);
+        int zz = (int)Math.round((z / this.zoom) + this.zOffsetNoise.generateNoise2D(x * this.variation / this.zoom, z * this.variation / this.zoom) * this.strength);
+        return this.parent.getCachedData(zx, zz);
+    }
+}
