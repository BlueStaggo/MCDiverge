+    public static Map<String, WeightedPool<Structure>> getMapFromName(String name) {
+        return NAMED_POOL_MAP.get(name);
+    }
+
+    public static Set<String> getPoolNames() {
+        return NAMED_POOL_MAP.keySet();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, WeightedPool<Structure>> makePoolMap(String name, Object... objects) {
+        if (objects.length % 2 != 0) throw new IllegalArgumentException("Length needs to be a multiple of 2");
+
+        Map<String, WeightedPool<Structure>> pool = new HashMap<>();
+        for (int i = 0; i + 1 < objects.length; i += 2) {
+            Object key = objects[i];
+            Object value = objects[i + 1];
+            pool.put((String)key, (WeightedPool<Structure>)value);
+        }
+
+        pool = Collections.unmodifiableMap(pool);
+        NAMED_POOL_MAP.put(name, pool);
+        return pool;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static WeightedPool<Structure> makeEvenPool(String... structures) {
+        return new WeightedPool<>(Arrays.stream(structures)
+                .map(Structure.STRUCTURE_LIST::get)
+                .map(structure -> new WeightedPool.Entry<>(structure, 1))
+                .toArray(WeightedPool.Entry[]::new));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static WeightedPool<Structure> makePool(Object... objects) {
+        if (objects.length % 2 != 0) throw new IllegalArgumentException("Length needs to be a multiple of 2");
+
+        WeightedPool.Entry<Structure>[] entries = (WeightedPool.Entry<Structure>[]) new WeightedPool.Entry<?>[objects.length / 2];
+        for (int i = 0; i + 1 < objects.length; i += 2) {
+            Object structure = objects[i];
+            Object weight = objects[i + 1];
+            float weightValue = weight instanceof Integer ? (float)(int)weight : (float)weight;
+            entries[i / 2] = new WeightedPool.Entry<>(Structure.STRUCTURE_LIST.get((String)structure), weightValue);
+        }
+
+        return new WeightedPool<>(entries);
+    }
