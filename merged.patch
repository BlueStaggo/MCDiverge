+				.noiseStretch(60.0D)
+				.heightOffset(10.0D)
+				.noiseUnderDamp(2.0D);
+	}
+
+	protected NoiseSettings.Builder buildBoostedNoiseSettings() {
+		return this.buildNoiseSettings()
+				.heightOffset(50.0D);
+	}
+
+	public NoiseSettings getNoiseSettings(NoiseSettingsModifiers modifiers) {
+		double boost = modifiers.boost;
+		boost = (boost - 0.5D) * 10.0D;
+		boost = MathHelper.clamp(boost, 0.0D, 1.0D);
+
+		if (boost == 0.0D) {
+			double hoodoo = this.hoodooNoise.generateNoiseNormalized2D(modifiers.x * 0.25D, modifiers.z * 0.25D);
+			hoodoo = (hoodoo - 0.5D) * 20.0D;
+			hoodoo = MathHelper.clamp(hoodoo, 0.0D, 1.0D);
+			boost += hoodoo;
