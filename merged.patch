+package net.minecraft.game.command;
+
+import net.minecraft.CommandContext;
+import net.minecraft.game.entity.player.PlayerEntity;
+import net.minecraft.util.MathHelper;
+
+import java.util.*;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+public class MultiPlayerParameter extends CommandParameter<Collection<PlayerEntity>> {
+    public MultiPlayerParameter(String name, String description, boolean required) {
+        super(name, description, null, required);
+    }
+
+    public List<String> getAutocompleteOptions(CommandContext context, String baseArgument, String query) {
+        List<String> baseList = Stream.concat(
+                Stream.of("@a", "@o", "@p", "@s"),
+                context.getPlayers().stream().map(player -> player.username)
+                        .sorted()
+        ).collect(Collectors.toList());
+        return Stream.concat(
+                baseList.stream(),
+                baseList.stream().map(s -> "!" + s)
+        ).collect(Collectors.toList());
+    }
+
+    public String getAutocompleteQuery(String argument) {
+        int comma = argument.lastIndexOf(',');
+        if (comma != -1) {
+            argument = argument.substring(comma + 1);
+        }
+        return argument;
+    }
+
+    public Collection<PlayerEntity> getDefault(CommandContext context) throws CommandParseException {
+        if (context == null) {
+            throw new CommandParseException("Could not find local player");
+        }
+
+        PlayerEntity localPlayer = context.getLocalPlayer();
+        if (localPlayer == null) {
+            throw new CommandParseException("Could not find local player");
+        }
+
+        return Collections.singleton(localPlayer);
+    }
+
+    protected Collection<PlayerEntity> parse(String input, CommandContext context) throws CommandParseException {
+        Set<PlayerEntity> players = new HashSet<>();
+        PlayerEntity localPlayer = context.getLocalPlayer();
+        for (String selector : input.split(",")) {
+            switch (selector) {
+                case "@s":
+                case "@p":
+                    if (localPlayer == null) {
+                        throw new CommandParseException("Could not find executor");
+                    }
+                    players.add(localPlayer);
+                    break;
+                case "@a":
+                    players.addAll(context.getPlayers());
+                    break;
+                case "@o":
+                    players.addAll(context.getOperators());
+                    break;
+                case "!@s":
+                case "!@p":
+                    if (localPlayer != null) {
+                        players.remove(localPlayer);
+                    }
+                    break;
+                case "!@a":
+                    players.removeAll(context.getPlayers());
+                    break;
+                case "!@o":
+                    players.removeAll(context.getOperators());
+                    break;
+                default:
+                    if (selector.startsWith("!")) {
+                        String username = selector.substring(1);
+                        players.removeIf(player -> player.username.equalsIgnoreCase(username));
+                    } else {
+                        PlayerEntity player = context.getPlayerFromUsername(selector);
+                        if (player == null) {
+                            throw new CommandParseException("Could not find player \"" + selector + "\"");
+                        }
+                        players.add(player);
+                    }
+                    break;
+            }
+        }
+
+        if (players.isEmpty() && this.required) {
+            throw new CommandParseException("No players targeted");
+        }
+
+        return players;
+    }
+}
