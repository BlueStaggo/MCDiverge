+package net.minecraft.util;
+
+public class ShortArray3D {
+	private final short[] array;
+	public final int width, length, height;
+
+	public ShortArray3D(int width, int height, int length) {
+		this(null, width, height, length);
+	}
+
+	public ShortArray3D(short[] array, int width, int height, int length) {
+		if (array == null) {
+			array = new short[width * height * length];
+		} else if (array.length < width * height * length) {
+			throw new IllegalArgumentException("Array is too small!");
+		}
+
+		this.array = array;
+		this.width = width;
+		this.height = height;
+		this.length = length;
+	}
+
+	public short get(int x, int y, int z) {
+		return this.array[(y * this.length + z) * this.width + x];
+	}
+
+	public void set(int x, int y, int z, short value) {
+		this.array[(y * this.length + z) * this.width + x] = value;
+	}
+
+	public short[] getArray() {
+		return array;
+	}
+}
