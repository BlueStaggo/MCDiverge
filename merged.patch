+        return (structure, world, random, x, y, z) -> {
+            int block = world.getBlockId(x, y, z);
+            if (block != Block.pumpkin.blockID && block != Block.jackOLantern.blockID) return;
+            if (random.nextFloat() > chance) {
+                world.setBlock(x, y, z, 0);
+                return;
+            }
+
+            world.setBlock(x, y, z, Block.mobSpawner.blockID);
+            MobSpawnerTileEntity mobSpawner = world.getBlockTileEntity(x, y, z, MobSpawnerTileEntity.class);
+            if (mobSpawner == null) throw new NullPointerException("For some reason the mob spawner isn't actually here");
+            mobSpawner.xCoord = x;
+            mobSpawner.yCoord = y;
+            mobSpawner.zCoord = z;
+            mobSpawner.setMobID(EntityRegistry.getEntityString(entityPool.get(random)));
+            structure.addTileEntity(mobSpawner);
+        };
+    }
+
+    private static StructureBlockModifier randomReplace(RandomReplaceTarget... targets) {
+        return (structure, world, random, x, y, z) -> {
+            int id = world.getBlockId(x, y, z);
+            int meta = world.getBlockMetadata(x, y, z);
+            for (RandomReplaceTarget target : targets) {
+                if (id != target.fromId
+                        || meta != target.fromMeta && target.fromMeta != -1
+                        || random.nextFloat() > target.chance) continue;
+                world.setBlockAndMetadata(x, y, z, target.toId, target.toMeta);
+                return;
+            }
+        };
+    }
+
+    private static class RandomReplaceTarget {
+        public final int fromId, fromMeta, toId, toMeta;
+        public final float chance;
+
+        private RandomReplaceTarget(int fromId, int fromMeta, int toId, int toMeta, float chance) {
+            this.fromId = fromId;
+            this.fromMeta = fromMeta;
+            this.toId = toId;
+            this.toMeta = toMeta;
+            this.chance = chance;
+        }
+    }
+
+    private static void registerBlockModifier(StructureBlockModifier modifier, String... structures) {
+        for (String structure : structures) {
+            map.put(Structure.STRUCTURE_LIST.get(structure), modifier);
+        }
+    }
+
+    static {
+        registerBlockModifier(
+                ABANDONED_SHACK,
+                "abandoned_shack.room_0",
+                "abandoned_shack.room_1",
+                "abandoned_shack.room_2",
+                "abandoned_shack.room_3",
+                "abandoned_shack.room_4",
+                "abandoned_shack.room_5"
+        );
+    }
+
+    public static StructureBlockModifier getBlockModifierFromStructure(Structure structure) {
+        return map.get(structure);
+    }
