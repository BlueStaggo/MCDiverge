+
+public class CraftingRecipe {
+	public final ItemStack result;
+	public final List<ItemStack> ingredients;
+
+	public CraftingRecipe(ItemStack result, List<ItemStack> b) {
+		this.result = result;
+		this.ingredients = b;
+	}
+
+	public boolean canCraft(ItemStack... items) {
+		for (ItemStack ingredient : this.ingredients) {
+			if (Arrays.stream(items).noneMatch(i -> i != null && i.isStackCompatible(ingredient))) {
+				return false;
+			}
+		}
+		return true;
+	}
+
+	public boolean hasMaterials(ItemStack... items) {
+		for (ItemStack ingredient : this.ingredients) {
+			if (Arrays.stream(items).anyMatch(i ->
+					i != null
+							&& i.id == ingredient.id
+							&& i.isBlock == ingredient.isBlock
+							&& (ingredient.getItemDamage() < 0 || i.getItemDamage() == ingredient.getItemDamage()))) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	public CraftingRecipe invalidate() {
+		return new CraftingRecipe(new ItemStack(this.result.id, -this.result.count, this.result.getItemDamage(), this.result.isBlock), this.ingredients);
+	}
+
+	public boolean equals(Object o) {
+		if (this == o) return true;
+		if (o == null || getClass() != o.getClass()) return false;
+		CraftingRecipe pair = (CraftingRecipe) o;
+		return Objects.equals(result, pair.result) && Objects.equals(ingredients, pair.ingredients);
+	}
+
+	public int hashCode() {
+		return Objects.hash(result, ingredients);
+	}
+}
