+        world.markBlocksDirty(
+                Math.min(x, cx * 16 + 8), y, Math.min(z, cz * 16 + 8),
+                Math.max(x + this.getWidth() - 1, cx * 16 + 23),
+                y + this.getHeight() - 1,
+                Math.max(z + this.getLength() - 1, cz * 16 + 23)
