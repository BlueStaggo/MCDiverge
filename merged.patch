+package net.minecraft.game.item;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public class CreativeInventoryBuilder {
+	private final List<ItemStack> items = new ArrayList<>();
+	private final List<InventoryReadonly.Label> labels = new ArrayList<>();
+
+	public void addLabel(String name, ItemStack icon) {
+		this.lineBreak();
+		this.newLine();
+		this.labels.add(new InventoryReadonly.Label(name, icon, this.items.size() / 8));
+	}
+
+	public void lineBreak() {
+		if (this.items.size() % 8 != 0)
+			newLine();
+	}
+
+	public void newLine() {
+		int emptyItems = 8 - (this.items.size() % 8);
+		for (int i = 0; i < emptyItems; i++) {
+			this.items.add(null);
+		}
+	}
+
+	public void addItem(int id, int meta, boolean isBlock) {
+		if (id < 0 || Item.fromID(id, isBlock) == null) {
+			this.items.add(null);
+			return;
+		}
+
+		ItemStack item = new ItemStack(id, 1, meta, isBlock);
+		this.items.add(item);
+	}
+
+	public void addItem(ItemStack itemStack) {
+		this.items.add(itemStack);
+	}
+
+	public InventoryReadonly toInventory() {
+		return new InventoryReadonly(items.toArray(new ItemStack[0]), true, labels);
+	}
+}
