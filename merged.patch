+
+public class SpeedModifier implements CharmModifier {
+    public float speedBoost;
+    public float chargeMaxBoost;
+    public float chargeRateBoost;
+    public float chargeRecoveryBoost;
+    public float attackSpeedBoost;
+
+    public SpeedModifier speedBoost(float speedBoost) {
+        this.speedBoost = speedBoost;
+        return this;
+    }
+
+    public SpeedModifier chargeMaxBoost(float chargeMaxBoost) {
+        this.chargeMaxBoost = chargeMaxBoost;
+        return this;
+    }
+
+    public SpeedModifier chargeRateBoost(float chargeRateBoost) {
+        this.chargeRateBoost = chargeRateBoost;
+        return this;
+    }
+
+    public SpeedModifier chargeRecoveryBoost(float chargeRecoveryBoost) {
+        this.chargeRecoveryBoost = chargeRecoveryBoost;
+        return this;
+    }
+
+    public SpeedModifier attackSpeedBoost(float attackSpeedBoost) {
+        this.attackSpeedBoost = attackSpeedBoost;
+        return this;
+    }
+
+    public void updateEquip(PlayerEntity player, ItemStack stack) {
+        player.attackSpeed /= 1.0F + this.attackSpeedBoost;
+        player.groundSpeedMultiplier *= 1.0F + this.speedBoost;
+        player.airSpeedMultiplier *= 1.0F + this.speedBoost;
+        player.sprintChargeMax *= 1.0F + this.chargeMaxBoost;
+        player.sprintBoostRate *= 1.0F + (player.sprintCharge >= 1.0F ? this.chargeRateBoost : this.chargeRecoveryBoost);
+    }
+
+    public void buildTooltipFromStack(ItemStack item, List<String> tooltip) {
+        if (this.attackSpeedBoost > 0.0F) {
+            tooltip.add(tooltip.size() - 1, i18nf("tooltip.attackSpeedBoost", StringTranslate.formatFloat(this.attackSpeedBoost * 100.0F, true)));
+        }
+        if (this.speedBoost > 0.0F) {
+            tooltip.add(tooltip.size() - 1, i18nf("tooltip.speedBoost", StringTranslate.formatFloat(this.speedBoost * 100.0F, true)));
+        }
+        if (this.chargeRateBoost > 0.0F) {
+            tooltip.add(tooltip.size() - 1, i18nf("tooltip.chargeRateBoost", StringTranslate.formatFloat(this.chargeRateBoost * 100.0F, true)));
+        }
+        if (this.chargeRecoveryBoost > 0.0F) {
+            tooltip.add(tooltip.size() - 1, i18nf("tooltip.chargeRecoveryBoost", StringTranslate.formatFloat(this.chargeRecoveryBoost * 100.0F, true)));
+        }
+        if (this.chargeMaxBoost > 0.0F) {
+            tooltip.add(tooltip.size() - 1, i18nf("tooltip.chargeMaxBoost", StringTranslate.formatFloat(this.chargeMaxBoost * 100.0F, true)));
+        }
+    }
