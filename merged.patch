+
+@FunctionalInterface
+public interface DrawingBrush {
+    BlockState getBlock(World world, int x, int y, int z);
+
+    class FromHand implements DrawingBrush {
+        private final PlayerEntity player;
+
+        public FromHand(PlayerEntity player) {
+            this.player = player;
+        }
+
+        public BlockState getBlock(World world, int x, int y, int z) {
+            ItemStack itemStack = player.inventory.getCurrentItem();
+            if (itemStack == null) return BlockState.AIR;
+
+            Item item = itemStack.getItem();
+            Block block = item.getCorrespondingBlock();
+            if (block == null) {
+                return BlockState.AIR;
+            }
+
+            int metadata = item.getPlacedBlockMetadata(itemStack.getItemDamage());
+            int direction = MathHelper.floor((double)(player.rotationYaw * 4.0F / 360.0F) + 0.5D) & 3;
+            return new BlockState(block.blockID, block.rotateMetadata(metadata, direction + 1));
+        }
+
+        public String toString() {
+            return "Player's Hand";
+        }
+    }
+
+    class Solid implements DrawingBrush {
+        private final BlockState block;
+
+        public Solid(BlockState block) {
+            this.block = block;
+        }
+
+        public BlockState getBlock(World world, int x, int y, int z) {
+            return this.block;
+        }
+
+        public String toString() {
+            return "Solid " + this.block;
+        }
+    }
+
+    class Replace implements DrawingBrush {
+        private final DrawingBrush baseBrush;
+        private final boolean reverse;
+        private final Set<BlockState> blocksToReplace;
+
+        public Replace(DrawingBrush baseBrush, boolean reverse, BlockState... blocksToReplace) {
+            this.baseBrush = baseBrush;
+            this.reverse = reverse;
+            this.blocksToReplace = Stream.of(blocksToReplace).collect(Collectors.toSet());
+        }
+
+        public BlockState getBlock(World world, int x, int y, int z) {
+            int id = world.getBlockId(x, y, z);
+            int metadata = world.getBlockMetadata(x, y, z);
+            boolean success = this.reverse;
+            if (this.blocksToReplace.contains(new BlockState(id, metadata))
+                    || this.blocksToReplace.contains(new BlockState(id, -1))) {
+                success = !success;
+            }
+            return success ? this.baseBrush.getBlock(world, x, y, z) : null;
+        }
+
+        public String toString() {
+            return (this.reverse ? "Ignore " : "Replace ")
+                    + this.blocksToReplace.stream()
+                            .map(Object::toString).collect(Collectors.joining(", "))
+                    + " with "
+                    + this.baseBrush;
+        }
+    }
+}
