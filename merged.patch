+    }
+
+    public boolean intersectsChunk(int cx, int cz) {
+        return this.x + this.structure.width - 1 >= cx * 16 + 8
+                && this.z + this.structure.length - 1 >= cz * 16 + 8
+                && this.x <= cx * 16 + 23
+                && this.z <= cz * 16 + 23;
+    }
+
+    public boolean intersects(StructurePlacement other) {
+        return this.x + this.getWidth() - 1 >= other.x
+                && this.x <= other.x + other.getWidth() - 1
+                && this.z + this.getLength() - 1 >= other.z
+                && this.z <= other.z + other.getLength() - 1
+                && this.y + this.getHeight() - 1 >= other.y
+                && this.y <= other.y + other.getHeight() - 1;
+    }
+
+    private int rotateX(int x, int z) {
+        return rotateX(x, z, this.rotation, this.structure.width, this.structure.length);
+    }
+
+    private int rotateZ(int x, int z) {
+        return rotateZ(x, z, this.rotation, this.structure.width, this.structure.length);
+    }
+
+    private static int rotateX(int x, int z, int rotation, int width, int length) {
+        switch (rotation) {
+            case 0: return x;
+            case 1: return length - z - 1;
+            case 2: return width - x - 1;
+            case 3: return z;
+            default: return x;
+        }
+    }
+
+    private static int rotateZ(int x, int z, int rotation, int width, int length) {
+        switch (rotation) {
+            case 0: return z;
+            case 1: return x;
+            case 2: return length - z - 1;
+            case 3: return width - x - 1;
+            default: return z;
+        }
+    }
+
+    private static boolean isPointInChunk(int x, int z, int cx, int cz) {
