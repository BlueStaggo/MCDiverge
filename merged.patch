+package net.minecraft.game.world.drawing;
+
+import net.minecraft.game.world.BlockPos;
+
+import java.util.function.Consumer;
+
+public enum LineOperation implements DrawingOperation {
+    LINE("Line"),
+    WALL("Wall");
+
+    private final String name;
+
+    LineOperation(String name) {
+        this.name = name;
+    }
+
+    public String getName() {
+        return this.name;
+    }
+
+    public String[] getCoordinatePrompts() {
+        return TWO_POINTS_PROMPTS;
+    }
+
+    public void draw(DrawingManager.Access draw, BlockPos[] coordinates) {
+        BlockPos a = coordinates[0];
+        BlockPos b = coordinates[1];
+
+        line3D(b.x, b.y, b.z, a.x, a.y, a.z, pos -> {
+            if (this == WALL) {
+                int minY = Math.min(a.y, b.y);
+                int maxY = Math.max(a.y, b.y);
+                for (int y = minY; y <= maxY; y++) {
+                    draw.addBlock(pos.x, y, pos.z);
+                }
+            } else {
+                draw.addBlock(pos.x, pos.y, pos.z);
+            }
+        });
+    }
+
+    // Algorithm by John Amanatides and Andrew Woo (http://www.cs.yorku.ca/~amana/research/grid.pdf)
+    // Adapted to C++ by yaqian chen (https://stackoverflow.com/a/55277311)
+    // Adapted to Java by BlueStaggo
+    private static void line3D(int x1, int y1, int z1, int x0, int y0, int z0, Consumer<BlockPos> drawer) {
+        int dx = Math.abs(x1 - x0);
+        int dy = Math.abs(y1 - y0);
+        int dz = Math.abs(z1 - z0);
+        int stepX = x0 < x1 ? 1 : -1;
+        int stepY = y0 < y1 ? 1 : -1;
+        int stepZ = z0 < z1 ? 1 : -1;
+
+        double hypotenuse = Math.sqrt(dx * dx + dy * dy + dz * dz);
+        double tMaxX = hypotenuse * 0.5D / dx;
+        double tMaxY = hypotenuse * 0.5D / dy;
+        double tMaxZ = hypotenuse * 0.5D / dz;
+        double tDeltaX = hypotenuse / dx;
+        double tDeltaY = hypotenuse / dy;
+        double tDeltaZ = hypotenuse / dz;
+
+        drawer.accept(new BlockPos(x0, y0, z0));
+        while (x0 != x1 || y0 != y1 || z0 != z1) {
+            if (tMaxX < tMaxY) {
+                if (tMaxX < tMaxZ) {
+                    x0 += stepX;
+                    tMaxX += tDeltaX;
+                } else if (tMaxX > tMaxZ) {
+                    z0 += stepZ;
+                    tMaxZ += tDeltaZ;
+                } else {
+                    x0 += stepX;
+                    tMaxX += tDeltaX;
+                    z0 += stepZ;
+                    tMaxZ += tDeltaZ;
+                }
+            } else if (tMaxX > tMaxY) {
+                if (tMaxY < tMaxZ) {
+                    y0 += stepY;
+                    tMaxY += tDeltaY;
+                } else if (tMaxY > tMaxZ) {
+                    z0 += stepZ;
+                    tMaxZ += tDeltaZ;
+                } else {
+                    y0 += stepY;
+                    tMaxY += tDeltaY;
+                    z0 += stepZ;
+                    tMaxZ += tDeltaZ;
+                }
+            } else {
+                if (tMaxY < tMaxZ) {
+                    y0 += stepY;
+                    tMaxY += tDeltaY;
+                    x0 += stepX;
+                    tMaxX += tDeltaX;
+                } else if (tMaxY > tMaxZ) {
+                    z0 += stepZ;
+                    tMaxZ += tDeltaZ;
+                } else {
+                    x0 += stepX;
+                    tMaxX += tDeltaX;
+                    y0 += stepY;
+                    tMaxY += tDeltaY;
+                    z0 += stepZ;
+                    tMaxZ += tDeltaZ;
+                }
+            }
+            drawer.accept(new BlockPos(x0, y0, z0));
+        }
+    }
