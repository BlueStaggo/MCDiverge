+package net.minecraft.game.world.drawing;
+
+import net.minecraft.CommandContext;
+import net.minecraft.game.world.BlockPos;
+import net.minecraft.game.world.World;
+
+import java.util.*;
+import java.util.stream.Collectors;
+
+public class DrawingManager {
+    private static final int MAX_HISTORY = 100;
+
+    private final Deque<List<PositionalBlockState>> undoHistory = new LinkedList<>();
+    private final Deque<List<PositionalBlockState>> redoHistory = new LinkedList<>();
+    private final CommandContext context;
+    private List<PositionalBlockState> clipboard = null;
+    private DrawingBrush brush;
+    private DrawingOperation currentOperation;
+    private String[] coordinatePrompts;
+    private BlockPos[] coordinates;
+    private int coordinateIndex;
+    private boolean staticMode;
+
+    public DrawingManager(CommandContext context) {
+        this.context = context;
+        this.brush = new DrawingBrush.FromHand(context.getLocalPlayer());
+    }
+
+    public void start(DrawingOperation operation) {
+        if (this.currentOperation != null) {
+            this.reset();
+        }
+        this.currentOperation = operation;
+        this.coordinatePrompts = operation.getCoordinatePrompts();
+        this.coordinates = new BlockPos[this.coordinatePrompts.length];
+        this.coordinateIndex = 0;
+        this.context.sendMessage("§dDrawing " + operation.getName() + "...");
+        this.printCoordinatePrompt();
+    }
+
+    public boolean hasStaticMode() {
+        return this.staticMode;
+    }
+
+    public void setStaticMode(boolean staticMode) {
+        this.staticMode = staticMode;
+        this.context.sendMessage(staticMode
+                ? "§dStatic mode enabled"
+                : "§dStatic mode disabled");
+    }
+
+    public void abort() {
+        if (this.currentOperation == null) return;
+
+        this.reset();
+        this.context.sendMessage("§dAborted drawing operation");
+        if (this.staticMode) {
+            this.setStaticMode(false);
+        }
+    }
+
+    public boolean undo() {
+        return this.manageHistory(this.undoHistory, this.redoHistory);
+    }
+
+    public boolean redo() {
+        return this.manageHistory(this.redoHistory, this.undoHistory);
+    }
+
+    public boolean handleBlockEvent(int x, int y, int z) {
+        if (this.currentOperation == null) return false;
+
+        this.coordinates[this.coordinateIndex] = new BlockPos(x, y, z);
+        this.context.sendMessage("§1--> §3" + this.coordinates[this.coordinateIndex]);
+        this.coordinateIndex++;
+
+        if (this.coordinateIndex >= this.coordinates.length) {
+            this.submit();
+        } else {
+            this.printCoordinatePrompt();
+        }
+        return true;
+    }
+
+    public void rotateClipboard(int axis, int amount) {
+        for (int i = 0; i < this.clipboard.size(); i++) {
+            this.clipboard.set(i, this.clipboard.get(i).rotate(axis, amount));
+        }
+        this.context.sendMessage("§dRotated clipboard around " + (char)('X' + axis) + " axis by " + (amount * 90) + " degrees");
+    }
+
+    public List<PositionalBlockState> getClipboard() {
+        return Collections.unmodifiableList(this.clipboard);
+    }
+
+    public DrawingBrush getBrush() {
+        return this.brush;
+    }
+
+    public void setBrush(DrawingBrush brush) {
+        if (brush == null) {
+            brush = new DrawingBrush.FromHand(this.context.getLocalPlayer());
+        }
+        this.brush = brush;
+        this.context.sendMessage("§9Set brush to " + brush);
+    }
+
+    public List<BlockPos> getSelectedCoordinates() {
+        if (this.coordinates == null) return Collections.emptyList();
+        return Arrays.stream(this.coordinates).filter(Objects::nonNull).collect(Collectors.toList());
+    }
+
+    public boolean isDrawing() {
+        return this.currentOperation != null;
+    }
+
+    protected void reset() {
+        this.currentOperation = null;
+        this.coordinatePrompts = null;
+        this.coordinates = null;
+        this.coordinateIndex = 0;
+    }
+
+    protected void submit() {
+        if (this.currentOperation == null || this.coordinateIndex < this.coordinates.length) return;
+
+        List<PositionalBlockState> log = new ArrayList<>();
+        DrawingLogType logType = this.currentOperation.getTargetLog();
+
+        this.currentOperation.draw(new Access(this, log, logType), this.coordinates);
+
+        switch (logType) {
+            case HISTORY:
+                Collections.reverse(log);
+                this.redoHistory.clear();
+                this.undoHistory.addFirst(log);
+                while (this.undoHistory.size() > MAX_HISTORY) {
+                    this.undoHistory.removeLast();
+                }
+                break;
+            case CLIPBOARD:
+                this.clipboard = log;
+                break;
+        }
+
+        this.context.sendMessage("§dModified " + log.size() + " blocks");
+
+        if (this.staticMode) {
+            this.start(this.currentOperation);
+        } else {
+            this.reset();
+        }
+    }
+
+    protected void printCoordinatePrompt() {
+        this.context.sendMessage("§1- §9" + this.coordinatePrompts[this.coordinateIndex]);
+    }
+
+    private boolean manageHistory(Deque<List<PositionalBlockState>> from, Deque<List<PositionalBlockState>> to) {
+        List<PositionalBlockState> fromHistory = from.pollFirst();
+        if (fromHistory == null) return false;
+
+        World world = this.context.getWorld();
+        List<PositionalBlockState> toHistory = new ArrayList<>();
+        for (PositionalBlockState entry : fromHistory) {
+            int x = entry.x;
+            int y = entry.y;
+            int z = entry.z;
+            int id = entry.id;
+            int metadata = entry.metadata;
+            toHistory.add(new PositionalBlockState(
+                    x, y, z,
+                    world.getBlockId(x, y, z),
+                    world.getBlockMetadata(x, y, z)
+            ));
+            world.setBlockAndMetadataWithNotify(x, y, z, id, metadata);
+        }
+
+        Collections.reverse(toHistory);
+        to.addFirst(toHistory);
+        while (to.size() > MAX_HISTORY) {
+            to.removeLast();
+        }
+
+        return true;
+    }
+
+    public static class Access {
+        private final DrawingManager draw;
+        private final World world;
+        private final DrawingBrush brush;
+        private final List<PositionalBlockState> log;
+        private final DrawingLogType logType;
+
+        private Access(DrawingManager draw, List<PositionalBlockState> log, DrawingLogType logType) {
+            this.draw = draw;
+            this.world = draw.context.getWorld();
+            this.brush = draw.brush;
+            this.log = log;
+            this.logType = logType;
+        }
+
+        public BlockState getBlock(BlockPos pos) {
+            return this.getBlock(pos.x, pos.y, pos.z);
+        }
+
+        public BlockState getBlock(int x, int y, int z) {
+            return new BlockState(
+                    this.world.getBlockId(x, y, z),
+                    this.world.getBlockMetadata(x, y, z)
+            );
+        }
+
+        public void addBlock(int x, int y, int z) {
+            this.addBlock(x, y, z, this.brush);
+        }
+
+        public void addBlock(int x, int y, int z, DrawingBrush brush) {
+            BlockState block = brush.getBlock(this.world, x, y, z);
+            if (block == null) return;
+            this.addBlock(x, y, z, block.id, block.metadata);
+        }
+
+        public void addBlock(int x, int y, int z, int id, int metadata) {
+            if (metadata < 0 || metadata > 255) metadata = 0;
+            switch (this.logType) {
+                case CLIPBOARD:
+                    this.log.add(new PositionalBlockState(x, y, z, id, metadata));
+                    break;
+
+                default:
+                    this.log.add(new PositionalBlockState(x, y, z, this.world.getBlockId(x, y, z), this.world.getBlockMetadata(x, y, z)));
+                    this.world.setBlockAndMetadata(x, y, z, id, metadata);
+                    this.world.markBlockNeedsUpdate(x, y, z);
+                    break;
+            }
+        }
+
+        public BlockState getBrushBlock(int x, int y, int z) {
+            return this.brush.getBlock(this.world, x, y, z);
+        }
+
+        public BlockState getBrushBlock(int x, int y, int z, DrawingBrush brush) {
+            return brush.getBlock(this.world, x, y, z);
+        }
+
+        public List<PositionalBlockState> getClipboard() {
+            return this.draw.getClipboard();
+        }
+    }
+}
