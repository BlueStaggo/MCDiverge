+		this(null, width, height, length);
+	}
+
+	public IntArray3D(int[] array, int width, int height, int length) {
+		if (array == null) {
+			array = new int[width * height * length];
+		} else if (array.length < width * height * length) {
+			throw new IllegalArgumentException("Array is too small!");
+		}
+
+		this.array = array;
+		this.width = width;
+		this.height = height;
+		this.length = length;
+	}
+
+	public int get(int x, int y, int z) {
+		return this.array[(y * this.length + z) * this.width + x];
+	}
+
+	public void set(int x, int y, int z, int value) {
+		this.array[(y * this.length + z) * this.width + x] = value;
+	}
+
+	public int[] getArray() {
+		return array;
+	}
+}
