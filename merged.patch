+package net.minecraft.game.item.loot;
+
+import net.minecraft.game.item.ItemStack;
+
+import java.util.Random;
+import java.util.function.BiPredicate;
+import java.util.function.Predicate;
+
+public class ConditionalLoot<T> implements LootEntry<T> {
+	public final BiPredicate<T, Random> predicate;
+	public final LootEntry<T> onTrue;
+	public final LootEntry<T> onFalse;
+
+	public ConditionalLoot(BiPredicate<T, Random> predicate, LootEntry<T> onTrue) {
+		this(predicate, onTrue, null);
+	}
+
+	public ConditionalLoot(Predicate<T> predicate, LootEntry<T> onTrue) {
+		this((a, b) -> predicate.test(a), onTrue, null);
+	}
+
+	public ConditionalLoot(Predicate<T> predicate, LootEntry<T> onTrue, LootEntry<T> onFalse) {
+		this((a, b) -> predicate.test(a), onTrue, onFalse);
+	}
+
+	public ConditionalLoot(BiPredicate<T, Random> predicate, LootEntry<T> onTrue, LootEntry<T> onFalse) {
+		this.predicate = predicate;
+		this.onTrue = onTrue;
+		this.onFalse = onFalse;
+	}
+
+	public ItemStack getItem(T modifier, Random random) {
+		LootEntry<T> loot = this.predicate.test(modifier, random) ? this.onTrue : this.onFalse;
+		if (loot == null) return null;
+		return loot.getItem(modifier, random);
+	}
+}
