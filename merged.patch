+package net.minecraft.util;
+
+public class NibbleArray3D {
+	private final byte[] array;
+	public final int width, length, height;
+
+	public NibbleArray3D(int width, int height, int length) {
+		this(null, width, height, length);
+	}
+
+	public NibbleArray3D(byte[] array, int width, int height, int length) {
+		if (array == null) {
+			array = new byte[width * height * length / 2];
+		} else if (array.length < width * height * length / 2) {
+			throw new IllegalArgumentException("Array is too small!");
+		}
+
+		this.array = array;
+		this.width = width;
+		this.height = height;
+		this.length = length;
+	}
+
+	public int get(int x, int y, int z) {
+		int index = (y * this.length + z) * this.width + x;
+		int nibblePair = this.array[index >> 1] & 0xFF;
+		return (index & 1) == 0 ? nibblePair & 0xF : (nibblePair >> 4) & 0xF;
+	}
+
+	public void set(int x, int y, int z, int value) {
+		int index = (y * this.length + z) * this.width + x;
+		int nibblePair = this.array[index >> 1] & 0xFF;
+		if ((index & 1) == 0) {
+			this.array[index >> 1] = (byte)(nibblePair & 0xF0 | value & 0xF);
+		} else {
+			this.array[index >> 1] = (byte)(nibblePair & 0xF | (value & 0xF) << 4);
+		}
+	}
+
+	public byte[] getArray() {
+		return array;
+	}
+}
