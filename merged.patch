+						int lz = bz + (rand.nextInt(3) - 1);
+						this.placeLeaves(world, rand, lx, lyWorld, lz, 3 + rand.nextInt(3) / 2);
+					}
+				}
+			}
+		}
+
+		for (int ly = 0; ly < leavesHeight; ly++) {
+			int lyWorld = y + trunkHeight - ly;
