+package net.minecraft.game.world.biome.layers;
+
+import net.minecraft.game.world.terrain.noise.SimplexNoiseOctaves;
+import net.minecraft.util.MathHelper;
+
+import java.util.Random;
+
+public class LayerClimate extends Layer {
+	private SimplexNoiseOctaves temperatureNoise;
+	private final double temperatureScale = 1.0D;
+	private final double[] temperature = new double[9];
+
+	public LayerClimate(long seed) {
+		super(seed);
+	}
+
+	public void setWorldSeed(long seed) {
+		super.setWorldSeed(seed);
+		Random random = new Random(this.getWorldSeed());
+		this.temperatureNoise = new SimplexNoiseOctaves(random, 4);
+	}
+
+	public int getData(int x, int z) {
+		this.setChunkSeed(x, z);
+
+		this.temperatureNoise.generateNoiseArray2D(temperature,
+				x - 1, z - 1, 3, 3, this.temperatureScale, this.temperatureScale, 0.5D, 0.75D);
+
+		double t = 0.0D;
+		for (int i = 0; i < 9; i++) {
+			t += this.remapTemperature(temperature[i]);
+		}
+		t /= 9.0D;
+
+		return MathHelper.clamp((int)Math.round(t), 0, 4);
+	}
+
+	private double remapTemperature(double t) {
+		t = Math.pow(Math.abs(t), 1.4D) * Math.signum(t);
+		t *= 2.4D;
+		t += 2.0D;
+		return t;
+	}
+}
