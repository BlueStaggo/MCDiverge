+import net.minecraft.game.world.IBlockPos;
+import net.minecraft.game.world.block.Block;
+
+public class PositionalBlockState {
+    public final int x, y, z, id, metadata;
+
+    public PositionalBlockState(IBlockPos<?> pos, BlockState block) {
+        this(pos.getX(), pos.getY(), pos.getZ(), block.id, block.metadata);
+    }
+
+    public PositionalBlockState(int x, int y, int z, int id, int metadata) {
+        this.x = x;
+        this.y = y;
+        this.z = z;
+        this.id = id;
+        this.metadata = metadata;
+    }
+
+    // Axis: 0 for X, 1 for Y, 2 for Z
+    public PositionalBlockState rotate(int axis, int rotation) {
+        int x = this.x;
+        int y = this.y;
+        int z = this.z;
+
+        switch (axis) {
+            case 0:
+                switch (rotation & 3) {
+                    case 0: y = +this.y; z = +this.z; break;
+                    case 1: y = -this.z; z = +this.y; break;
+                    case 2: y = -this.y; z = -this.z; break;
+                    case 3: y = +this.z; z = -this.y; break;
+                    default: throw new IllegalArgumentException("How???");
+                }
+                break;
+
+            case 1:
+                switch (rotation & 3) {
+                    case 0: x = +this.x; z = +this.z; break;
+                    case 1: x = -this.z; z = +this.x; break;
+                    case 2: x = -this.x; z = -this.z; break;
+                    case 3: x = +this.z; z = -this.x; break;
+                    default: throw new IllegalArgumentException("How???");
+                }
+                break;
+
+            case 2:
+                switch (rotation & 3) {
+                    case 0: x = +this.x; y = +this.y; break;
+                    case 1: x = -this.y; y = +this.x; break;
+                    case 2: x = -this.x; y = -this.y; break;
+                    case 3: x = +this.y; y = -this.x; break;
+                    default: throw new IllegalArgumentException("How???");
+                }
+                break;
+        }
+
+        int metadata = this.metadata;
+        if (axis == 1) {
+            Block block = Block.blocksList[this.id];
+            if (block != null) {
+                metadata = block.rotateMetadata(metadata, rotation);
+            }
+        }
+
+        return new PositionalBlockState(x, y, z, this.id, metadata);
+    }
+
+    public static PositionalBlockState fromNBT(CompoundTag compound) {
+        if (compound == null) return null;
+        return new PositionalBlockState(
+                compound.getInteger("x"),
+                compound.getInteger("y"),
+                compound.getInteger("z"),
+                compound.getInteger("id"),
+                compound.getByte("metadata") & 0xFF
+        );
+    }
+
+    public static CompoundTag toNBT(PositionalBlockState block) {
+        if (block == null) return null;
+        CompoundTag compound = new CompoundTag();
+        compound.setInteger("x", block.x);
+        compound.setInteger("y", block.y);
+        compound.setInteger("z", block.z);
+        compound.setInteger("id", block.id);
+        compound.setByte("metadata", (byte)block.metadata);
+        return compound;
+    }
+}
