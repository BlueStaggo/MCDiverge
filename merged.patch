+
+public class SurfaceRuinsStructure extends TerrainGenStructure {
+    private static final long SALT
+            = (long)"By the name of King Arthur".hashCode()
+            | (long)"WHAT THE HELL HAPPENED TO OUR CASTLE!?".hashCode() << 32;
+    private static final Set<Biome> VALID_BIOMES = Stream.of(
+            Biome.plains,
+            Biome.forest,
+            Biome.bloomingForest,
+            Biome.desert,
+            Biome.taiga,
+            Biome.bloomingTaiga,
+            Biome.snowyTaiga,
+            Biome.tundra,
+            Biome.savanna,
+            Biome.rockyValley
+    ).collect(Collectors.toSet());
+
+    public boolean generateAt(World world, int x, int z) {
+        if (!this.generateOnGrid(x, z, 16, 8, SALT)) return false;
+        Biome biome = world.getBiomeSource().getBiomeGenAt(x * 16 + 8, z * 16 + 8);
+        return VALID_BIOMES.contains(biome) && this.rand.nextInt(5) == 0;
+    }
+
+    public List<StructurePlacement> buildStructure(int x, int z) {
+        List<StructurePlacement> list = new ArrayList<>();
+
+        int smallPieces = 30 + this.rand.nextInt(51);
+        int mediumPieces = 15 + this.rand.nextInt(11);
+
+        for (int i = 0; i < smallPieces; i++) {
+            list.add(StructurePlacement.onGround(
+                    Structure.STRUCTURE_LIST.get("surface_ruins.small_" + this.rand.nextInt(3)),
+                    x + this.randRuinPos(100, 0.5D),
+                    -2,
+                    z + this.randRuinPos(100, 0.5D),
+                    this.rand.nextInt(4)
+            ));
+        }
+
+        for (int i = 0; i < mediumPieces; i++) {
+            list.add(StructurePlacement.onGround(
+                    Structure.STRUCTURE_LIST.get("surface_ruins.medium_" + this.rand.nextInt(8)),
+                    x + this.randRuinPos(60, 0.5D),
+                    -4,
+                    z + this.randRuinPos(60, 0.5D),
+                    this.rand.nextInt(4)
+            ));
+        }
+
+        return list;
+    }
+
+    private int randRuinPos(int radius, double spread) {
+        return (int)(this.rand.nextDouble() * (spread + this.rand.nextDouble() * (1.0D - spread)) * radius) * (this.rand.nextBoolean() ? -1 : 1);
+    }
+}
