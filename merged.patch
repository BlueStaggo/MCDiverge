+import net.minecraft.util.MathHelper;
+
+public class CoordinateParameter extends DoubleParameter {
+    public static final int X_AXIS = 0;
+    public static final int Y_AXIS = 1;
+    public static final int Z_AXIS = 2;
+    public static final int YAW = 3;
+    public static final int PITCH = 4;
+    private final int axis;
+
+    public CoordinateParameter(String name, String description, int axis, Double defaultValue) {
+        super(name, description, defaultValue);
+        if (axis < 0 || axis > 4) {
+            throw new IllegalArgumentException("Invalid axis provided!");
+        }
+        this.axis = axis;
+    }
+
+    public Double getDefault(CommandContext context) throws CommandParseException {
+        double value = super.getDefault(context);
+        if (Double.isNaN(value)) {
+            PlayerEntity player = context.getLocalPlayer();
+            if (player != null) {
+                value = this.getPlayerPositionByAxis(player);
+                if (this.axis == X_AXIS || this.axis == Y_AXIS || this.axis == Z_AXIS) {
+                    value = MathHelper.floor(value);
+                    if (this.axis == X_AXIS || this.axis == Z_AXIS) {
+                        value += 0.5D;
+                    }
+                }
+            }
+        }
+        return value;
+    }
+
+    private double getPlayerPositionByAxis(PlayerEntity player) {
+        switch (this.axis) {
+            case X_AXIS:
+                return player.posX;
+            case Y_AXIS:
+                return player.boundingBox.minY;
+            case Z_AXIS:
+                return player.posZ;
+            case YAW:
+                return player.rotationYaw;
+            case PITCH:
+                return player.rotationPitch;
+            default:
+                throw new IllegalStateException("Invalid axis stored");
+        }
+    }
+
+    protected Double parse(String input, CommandContext context) throws CommandParseException {
+        double value = 0.0D;
+        boolean foundRelative = false;
+        if (input.startsWith("~")) {
+            PlayerEntity player = context.getLocalPlayer();
+            if (player == null) {
+                throw new CommandParseException("Cannot use relative coordinates as a non-player");
+            }
+            input = input.substring(1);
+            value += this.getPlayerPositionByAxis(player);
+            foundRelative = true;
+        }
+
+        if (!foundRelative || !input.isEmpty()) {
+            value += super.parse(input, context);
+        }
+        if (!input.contains(".") && (this.axis == X_AXIS || this.axis == Y_AXIS || this.axis == Z_AXIS)) {
+            value = MathHelper.floor(value);
+            if (this.axis == X_AXIS || this.axis == Z_AXIS) {
+                value += 0.5D;
+            }
+        }
+
+        return value;
+    }
+}
