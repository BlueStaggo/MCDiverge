+                    "jigsaw_test.right", 2,
+                    "jigsaw_test.crossroads", 2,
+                    "jigsaw_test.stairs_up", 1,
+                    "jigsaw_test.stairs_down", 1
+            )
+    ),
+    ABANDONED_SHACK = makePoolMap(
+            "abandoned_shack",
+            "doorway", makeEvenPool(
+                    "abandoned_shack.room_0",
+                    "abandoned_shack.room_1",
+                    "abandoned_shack.room_2",
+                    "abandoned_shack.room_3",
+                    "abandoned_shack.room_4",
+                    "abandoned_shack.room_5"
+            ),
+            "down", makeEvenPool(
+                    "abandoned_shack.room_0",
+                    "abandoned_shack.room_2",
+                    "abandoned_shack.room_3"
+            ),
+            "up", makeEvenPool(
+                    "abandoned_shack.room_0",
+                    "abandoned_shack.room_2",
+                    "abandoned_shack.room_3"
+            )
+    );
+
+    private StructurePools() {
+    }
