+package net.minecraft.game.command;
+
+import net.minecraft.CommandContext;
+
+import java.util.*;
+import java.util.stream.Collectors;
+
+@SuppressWarnings("unchecked")
+public class CommandParameterList {
+    private final Map<CommandParameter<?>, PositionalCommandParameter<?>> positionalParameterMap = new HashMap<>();
+    private final PositionalCommandParameter<?>[] positionalParameters;
+
+    public CommandParameterList(CommandParameter<?>... parameters) {
+        this.positionalParameters = new PositionalCommandParameter[parameters.length];
+        for (int i = 0; i < parameters.length; i++) {
+            if (this.positionalParameterMap.containsKey(parameters[i])) {
+                throw new IllegalArgumentException("Duplicate command parameter " + parameters[i].name);
+            }
+
+            if (i != 0) {
+                if (this.positionalParameters[i - 1].unpositional.isVariadic()) {
+                    throw new IllegalArgumentException("Cannot insert any more parameters after a variadic parameter");
+                }
+                if (!this.positionalParameters[i - 1].unpositional.required && parameters[i].required) {
+                    throw new IllegalArgumentException("Cannot insert required parameters after optional parameters");
+                }
+            }
+
+            PositionalCommandParameter<?> positionalParameter = new PositionalCommandParameter<>((CommandParameter<Object>) parameters[i], i);
+            this.positionalParameterMap.put(parameters[i], positionalParameter);
+            this.positionalParameters[i] = positionalParameter;
+        }
+    }
+
+    public <T> T parse(CommandContext context, CommandParameter<T> argument, String[] stringArguments) throws CommandParseException {
+        return ((PositionalCommandParameter<T>) positionalParameterMap.get(argument)).parse(context, stringArguments);
+    }
+
+    public CommandArgumentList parseArguments(CommandContext context, String... arguments) throws CommandParseException {
+        Map<CommandParameter<?>, Object> values = new HashMap<>();
+        for (PositionalCommandParameter<?> parameter : this.positionalParameters) {
+            values.put(parameter.unpositional, parameter.parse(context, arguments));
+        }
+        return new CommandArgumentList(values);
+    }
+
+    public List<PositionalCommandParameter<?>> getPositionalParameters() {
+        return Collections.unmodifiableList(Arrays.asList(this.positionalParameters));
+    }
+
+    public String toString() {
+        return Arrays.stream(this.positionalParameters)
+                .map(p -> p.unpositional.toString())
+                .collect(Collectors.joining(" "));
+    }
+}
