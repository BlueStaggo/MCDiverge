+            int sx = this.rotateX(newTileEntity.xCoord, newTileEntity.zCoord);
+			int sy = newTileEntity.yCoord;
+			int sz = this.rotateZ(newTileEntity.xCoord, newTileEntity.zCoord);
+
+			newTileEntity.xCoord = x + sx;
+			newTileEntity.yCoord = y + sy;
+			newTileEntity.zCoord = z + sz;
+            this.tileEntitiesToPlace.add(newTileEntity);
+            if (newTileEntity instanceof JigsawTileEntity) {
+                JigsawTileEntity jigsaw = (JigsawTileEntity)newTileEntity;
+                jigsaw.direction = jigsaw.direction.rotate(rotation);
+                this.worldJigsaws.add(jigsaw);
+            }
