+	//#region Generate Methods
+	public void generate(Feature gen, int quantity, int minY, int maxY) {
+		generate(gen, quantity, minY, maxY, 8);
+	}
+
+	public void generate(Feature gen, int quantity, int minY, int maxY, int xzOffset) {
+		if (this.placementExecutorService != null) {
+			this.generateMultithreaded(gen, quantity, minY, maxY, xzOffset);
+		}
+
+		for (int i = 0; i < quantity; i++) {
+			int genX = x + rand.nextInt(16) + xzOffset;
+			int genY = minY == maxY ? minY : rand.nextInt(maxY - minY) + minY;
+			int genZ = z + rand.nextInt(16) + xzOffset;
+			gen.generate(worldObj, rand, genX, genY, genZ);
+		}
+	}
+
+	public void generateMultithreaded(Feature gen, int quantity, int minY, int maxY, int xzOffset) {
+		List<Callable<Void>> placements = new ArrayList<>();
+
+		for (int i = 0; i < quantity; i++) {
+			int genX = x + rand.nextInt(16) + xzOffset;
+			int genY = minY == maxY ? minY : rand.nextInt(maxY - minY) + minY;
+			int genZ = z + rand.nextInt(16) + xzOffset;
+			placements.add(() -> {
+				gen.generate(worldObj, new Random(rand.nextLong()), genX, genY, genZ);
+				return null;
+			});
+		}
+
+        try {
+            this.placementExecutorService.invokeAll(placements);
+        } catch (InterruptedException e) {
+            throw new RuntimeException(e);
+        }
+    }
+
