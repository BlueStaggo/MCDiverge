+            this.appendToDecreaseQueue(
+                    ((worldX + (worldZ << 6) + ((worldY - this.chunkOffsetY) << (6 + 6)) + encodeOffset) & ((1L << (6 + 6 + 16)) - 1))
+                            | (currentLevel & 0xFL) << (6 + 6 + 16)
+                            | (((long)ALL_DIRECTIONS_BITSET) << (6 + 6 + 16 + 4))
