+package net.minecraft.game.world.chunk.section;
+
+import com.mojang.nbt.CompoundTag;
+import net.minecraft.util.ByteArray3D;
+import net.minecraft.util.NibbleArray3D;
+
+public class TriNibbleBlockArray extends BlockArray {
+    protected final ByteArray3D byteData = new ByteArray3D(16, 16, 16);
+    protected final NibbleArray3D nibbleData = new NibbleArray3D(16, 16, 16);
+
+    protected int getMaxPaletteSize() {
+        return 4095;
+    }
+
+    protected int getBlockId(int x, int y, int z) {
+        return byteData.get(x, y, z) & 0xFF | nibbleData.get(x, y, z) << 8;
+    }
+
+    protected void setBlockId(int x, int y, int z, int id) {
+        byteData.set(x, y, z, (byte)(id & 0xFF));
+        nibbleData.set(x, y, z, ((id >> 8) & 0xF));
+    }
+
+    protected void readFromNBT(CompoundTag tag) {
+        byte[] oldByteData = this.byteData.getArray();
+        byte[] oldNibbleData = this.nibbleData.getArray();
+        byte[] newByteData = tag.getByteArray("ByteData");
+        byte[] newNibbleData = tag.getByteArray("NibbleData");
+        System.arraycopy(newByteData, 0, oldByteData, 0, Math.min(oldByteData.length, newByteData.length));
+        System.arraycopy(newNibbleData, 0, oldNibbleData, 0, Math.min(oldNibbleData.length, newNibbleData.length));
+    }
+
+    protected void writeToNBT(CompoundTag tag) {
+        tag.setByteArray("ByteData", this.byteData.getArray());
+        tag.setByteArray("NibbleData", this.nibbleData.getArray());
+    }
+
+    public BlockArray expand() {
+        ShortBlockArray blockArray = new ShortBlockArray();
+        blockArray.palette = this.palette;
+
+        int size = this.byteData.getArray().length;
+        for (int i = 0; i < size; i++) {
+            int x = i & 15;
+            int y = (i >> 4) & 15;
+            int z = (i >> 8) & 15;
+            blockArray.setBlockId(x, y, z, this.getBlock(x, y, z));
+        }
+
+        return blockArray;
+    }
+}
