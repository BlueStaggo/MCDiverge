+package net.minecraft.game.world.drawing;
+
+import net.minecraft.game.world.BlockPos;
+
+import java.util.Iterator;
+
+public class SphereOperation implements DrawingOperation {
+    private final Double radius;
+    private final boolean hollow;
+
+    public SphereOperation(Double radius, boolean hollow) {
+        this.radius = radius <= 0.0D ? null : radius;
+        this.hollow = hollow;
+    }
+
+    public String getName() {
+        return this.hollow ? "Hollow Sphere" : "Sphere";
+    }
+
+    public String[] getCoordinatePrompts() {
+        return this.radius == null ? SINGLE_POINT_WITH_RADIUS_PROMPTS : SINGLE_POINT_PROMPT;
+    }
+
+    public void draw(DrawingManager.Access draw, BlockPos[] coordinates) {
+        BlockPos center = coordinates[0];
+
+        double radius;
+        if (this.radius == null) {
+            radius = center.getDistanceTo(coordinates[1]);
+        } else {
+            radius = this.radius;
+        }
+        radius += 0.999D;
+
+        double radiusSquared = radius * radius;
+        double radiusM1Squared = (radius - 1) * (radius - 1);
+
+        int iRadius = (int)Math.ceil(radius);
+        Iterator<BlockPos> area = new BlockPos.CuboidIterator(
+                center.add(-iRadius, -iRadius, -iRadius),
+                center.add(iRadius, iRadius, iRadius)
+        );
+        while (area.hasNext()) {
+            BlockPos pos = area.next();
+            double dist = center.getSquaredDistanceTo(pos);
+            if (dist > radiusSquared) continue;
+            if (hollow && dist < radiusM1Squared) continue;
+            draw.addBlock(pos.x, pos.y, pos.z);
+        }
+    }
+}
