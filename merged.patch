+    public void advanceProcess(World world, int x, int y, int z, boolean dry) {
+        IngameHud hud = Minecraft.getInstance().ingameGUI;
+
+        switch (state) {
+            case 0:
+                state++;
+                switch (mode) {
+                    case 0:
+                        hud.addChatMessage("§dUsing the structure voider wand §7(sneak for dry run)");
+                        break;
+
+                    case 1:
+                        hud.addChatMessage("§5Using the structure devoider wand §7(sneak for dry run)");
+                        break;
+
