+
+        this.register(ServerCommandContext.class, cmd -> {
+            cmd.name("pardonip").description("Pardon players from the server by IP");
+
+            StringParameter $ip = cmd.addParameter(new StringParameter(
+                    "ip", "The ip to pardon", null));
+
+            cmd.handler((ctx, args) -> {
