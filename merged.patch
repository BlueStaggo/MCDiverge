+        data.set(x, y, z, id);
+    }
+
+    protected void readFromNBT(CompoundTag tag) {
+        byte[] oldData = this.data.getArray();
+        byte[] newData = tag.getByteArray("Data");
+        System.arraycopy(newData, 0, oldData, 0, Math.min(oldData.length, newData.length));
+    }
+
+    protected void writeToNBT(CompoundTag tag) {
+        tag.setByteArray("Data", this.data.getArray());
+    }
+
+    public BlockArray expand() {
+        ByteBlockArray blockArray = new ByteBlockArray();
+        blockArray.palette = this.palette;
