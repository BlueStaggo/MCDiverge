+        if (this.extBlocks != null) compound.setByteArray("ExtBlocks", this.extBlocks);
+        compound.setByteArray("Metadata", this.metadata);
+
+        ListTag tileEntitiesNBT = new ListTag();
+        for (TileEntity tileEntity : this.tileEntities) {
+            CompoundTag tileEntityNBT = new CompoundTag();
+            tileEntity.writeToNBT(tileEntityNBT);
+            tileEntitiesNBT.setTag(tileEntityNBT);
+        }
+        compound.setTag("TileEntities", tileEntitiesNBT);
+
+        return compound;
+    }
+
+    public static Structure fromNBT(CompoundTag compound) {
+        int width = compound.getInteger("Width");
+        int height = compound.getInteger("Height");
+        int length = compound.getInteger("Length");
+        byte[] blocks = compound.getByteArray("Blocks");
+        byte[] extBlocks = compound.hasKey("ExtBlocks") ? compound.getByteArray("ExtBlocks") : null;
+        byte[] metadata = compound.getByteArray("Metadata");
+
+        ListTag tileEntitiesNBT = compound.getTagList("TileEntities");
+        List<TileEntity> tileEntities = new ArrayList<>();
+
+        for (int i = 0; i < tileEntitiesNBT.tagCount(); i++) {
+            CompoundTag tileEntityNBT = (CompoundTag)tileEntitiesNBT.tagAt(i);
+            TileEntity tileEntity = TileEntity.createAndLoadEntity(tileEntityNBT, null);
+            tileEntities.add(tileEntity);
+        }
+
+        return new Structure(width, height, length, blocks, extBlocks, metadata, tileEntities);
+    }
+
+    private static Map<String, Structure> makeStructureList(String... names) {
+        Map<String, Structure> map = new HashMap<>();
+
+        for (String name : names) {
+            try (InputStream inputStream = Structure.class.getResourceAsStream("/net/minecraft/game/world/structure/data/" + name.replace('.', '/') + ".dat")) {
+                CompoundTag compound = CompressedStreamTools.readGzippedCompoundFromInputStream(inputStream);
+                map.put(name, Structure.fromNBT(compound));
+            } catch (Exception e) {
+                System.err.println("Failed to load structure \"" + name + "\"");
+                e.printStackTrace();
+                map.put(name, Structure.EMPTY);
+            }
+        }
+
+        return Collections.unmodifiableMap(map);
+    }
