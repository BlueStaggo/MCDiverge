+package net.minecraft.game.command;
+
+import net.minecraft.CommandContext;
+import net.minecraft.game.entity.player.PlayerEntity;
+import net.minecraft.util.MathHelper;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+public class PlayerParameter extends CommandParameter<PlayerEntity> {
+    public PlayerParameter(String name, String description, boolean required) {
+        super(name, description, null, required);
+    }
+
+    public List<String> getAutocompleteOptions(CommandContext context, String baseArgument, String query) {
+        return Stream.concat(
+                Stream.of("@p", "@s"),
+                context.getPlayers().stream().map(player -> player.username)
+                        .sorted()
+        ).collect(Collectors.toList());
+    }
+
+    public PlayerEntity getDefault(CommandContext context) throws CommandParseException {
+        if (context == null) {
+            throw new CommandParseException("Could not find local player");
+        }
+
+        PlayerEntity localPlayer = context.getLocalPlayer();
+        if (localPlayer == null) {
+            throw new CommandParseException("Could not find local player");
+        }
+
+        return localPlayer;
+    }
+
+    protected PlayerEntity parse(String input, CommandContext context) throws CommandParseException {
+        PlayerEntity player = "@s".equals(input) || "@p".equals(input)
+                ? context.getLocalPlayer()
+                : context.getPlayerFromUsername(input);
+        if (player == null) {
+            throw new CommandParseException("Could not find player \"" + input + "\"");
+        }
+
+        return player;
+    }
+}
