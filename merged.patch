+
+import java.util.*;
+import java.util.stream.Collectors;
+
+public class CharmItem extends EquippableItem {
+    public static String TYPE_MOVE_SPEED = "move_speed";
+    public static String TYPE_MOVE_ACCELERATION = "move_acceleration";
+    public static String TYPE_ATTACK_SPEED = "attack_speed";
+
+    private final CharmModifier[] modifiers;
+    private final Set<String> types;
+
+    @SuppressWarnings("unchecked")
+    public CharmItem(int var1, String[] types, CharmModifier... modifiers) {
+        super(var1, Slot.CHARM);
+        this.modifiers = modifiers;
+        this.types = types == null || types.length == 0 ? Collections.EMPTY_SET
+                : Arrays.stream(types).collect(Collectors.toSet());
+    }
+
+    public void updateEquip(PlayerEntity player, ItemStack stack) {
+        for (CharmModifier modifier : this.modifiers) {
+            modifier.updateEquip(player, stack);
+        }
+    }
+
+    public void buildTooltipFromStack(ItemStack item, List<String> tooltip, PlayerEntity player) {
+        super.buildTooltipFromStack(item, tooltip, player);
+        for (CharmModifier modifier : this.modifiers) {
+            modifier.buildTooltipFromStack(item, tooltip);
+        }
+    }
+
+    public boolean isCompatible(CharmItem otherCharm) {
+        if (otherCharm == null || this.types.isEmpty() || otherCharm.types.isEmpty()) return true;
+        if (otherCharm == this) return false;
+
+        for (String type : otherCharm.types) {
+            if (this.types.contains(type)) return false;
+        }
+        return true;
+    }
