+package net.minecraft.game.world.drawing;
+
+import net.minecraft.game.world.BlockPos;
+
+import java.util.Iterator;
+
+public enum CuboidOperation implements DrawingOperation {
+    SOLID("Cuboid"),
+    WALLS("Walls"),
+    HOLLOW("Hollow");
+
+    private final String name;
+
+    CuboidOperation(String name) {
+        this.name = name;
+    }
+
+    public String getName() {
+        return this.name;
+    }
+
+    public String[] getCoordinatePrompts() {
+        return TWO_POINTS_PROMPTS;
+    }
+
+    public void draw(DrawingManager.Access draw, BlockPos[] coordinates) {
+        BlockPos min = coordinates[0].min(coordinates[1]);
+        BlockPos max = coordinates[0].max(coordinates[1]);
+        Iterator<BlockPos> cuboid = new BlockPos.CuboidIterator(min, max);
+
+        while (cuboid.hasNext()) {
+            BlockPos pos = cuboid.next();
+            if ((this == WALLS || this == HOLLOW)
+                    && pos.x > min.x && pos.x < max.x
+                    && pos.z > min.z && pos.z < max.z) {
+                if (this != HOLLOW || (pos.y > min.y && pos.y < max.y)) {
+                    continue;
+                }
+            }
+
+            draw.addBlock(pos.x, pos.y, pos.z);
+        }
+    }
+}
