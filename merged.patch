+package net.minecraft.game.world.drawing;
+
+import net.minecraft.game.world.BlockPos;
+import net.minecraft.game.world.IBlockPos;
+import net.minecraft.game.world.MutableBlockPos;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+public class SmearOperation implements DrawingOperation {
+    private final int axis;
+    private final int distance;
+    private final int spacing;
+
+    public SmearOperation(int axis, int distance, int spacing) {
+        this.axis = axis;
+        this.distance = distance;
+        this.spacing = spacing;
+    }
+
+    public String getName() {
+        return "Smear";
+    }
+
+    public String[] getCoordinatePrompts() {
+        return TWO_POINTS_PROMPTS;
+    }
+
+    public void draw(DrawingManager.Access draw, BlockPos[] coordinates) {
+        if (this.distance == 0 || this.spacing == 0) {
+            return;
+        }
+
+        List<PositionalBlockState> blocks = new ArrayList<>();
+        List<IBlockPos<?>> placedPositions = new ArrayList<>();
+
+        Iterator<BlockPos> sourceArea = new BlockPos.CuboidIterator(coordinates[0], coordinates[1]);
+        while (sourceArea.hasNext()) {
+            BlockPos pos = sourceArea.next();
+            if (draw.getBrushBlock(pos.x, pos.y, pos.z) != null) {
+                blocks.add(new PositionalBlockState(pos, draw.getBlock(pos)));
+                placedPositions.add(pos);
+            }
+        }
+
+        MutableBlockPos offsetPos = new MutableBlockPos();
+        for (int offset = 1; offset <= this.distance; offset++) {
+            for (PositionalBlockState block : blocks) {
+                offsetPos.x = block.x;
+                offsetPos.y = block.y;
+                offsetPos.z = block.z;
+                offsetPos.addByAxis(this.axis, offset);
+
+                if (draw.getBlock(offsetPos.x, offsetPos.y, offsetPos.z) != null && !placedPositions.contains(offsetPos)) {
+                    placedPositions.add(offsetPos.immutable());
+                }
+                draw.addBlock(
+                        offsetPos.x,
+                        offsetPos.y,
+                        offsetPos.z,
+                        block.id,
+                        block.metadata
+                );
+            }
+        }
+    }
+}
