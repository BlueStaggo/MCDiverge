+			noiseSettings = new NoiseSettings[width * length];
+		}
+
+		int bx = x << 2;
+		int bz = z << 2;
+		int bwidth = width << 2;
+		int blength = length << 2;
+		double noiseRes = LayerPerlinNoise.RESOLUTION;
+		double edgeRes = LayerFillEdge.RESOLUTION;
+
+		this.noiseBiomeData = this.loadBlockGeneratorData(this.noiseBiomeData, bx, bz, bwidth, blength);
+
+		for (int xx = 0; xx < width; xx++) {
+			for (int zz = 0; zz < length; zz++) {
+				int bxx = xx << 2;
+				int bzz = zz << 2;
+				int i = xx * length + zz;
+
+				this.noiseSettingsModifiers.x = bxx + bx;
+				this.noiseSettingsModifiers.z = bzz + bz;
+				this.noiseSettingsModifiers.ocean = this.oceanLayer.getCachedData(bxx + bx, bzz + bz) / noiseRes;
+				this.noiseSettingsModifiers.edge = this.edgeLayer.getCachedData(bxx + bx, bzz + bz) / edgeRes;
+				this.noiseSettingsModifiers.boost = this.boostLayer.getCachedData(bxx + bx, bzz + bz) / noiseRes;
+				this.noiseSettingsModifiers.river = this.riverLayer.getCachedData(bxx + bx, bzz + bz) != 0;
+
+				noiseSettings[i] = this.noiseBiomeData[bxx * blength + bzz].getNoiseSettings(this.noiseSettingsModifiers);
+			}
+		}
+
+		return noiseSettings;
+	}
+
+	public Biome[] loadBlockGeneratorData(Biome[] biomes, int x, int z, int width, int length) {
+		if(biomes == null || biomes.length < width * length) {
