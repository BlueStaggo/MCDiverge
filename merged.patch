+package net.minecraft.game.command;
+
+import net.minecraft.CommandContext;
+import net.minecraft.util.Either;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+public class EitherParameter<A, B> extends CommandParameter<Either<A, B>> {
+    private final Class<A> classA;
+    private final Class<B> classB;
+    private final CommandParameter<A> parameterA;
+    private final CommandParameter<B> parameterB;
+
+    public EitherParameter(String description,
+                           Class<A> classA, Class<B> classB,
+                           CommandParameter<A> parameterA, CommandParameter<B> parameterB,
+                           Either<A, B> defaultValue) {
+        super(parameterA.name + "|" + parameterB.name, description, defaultValue);
+        this.classA = classA;
+        this.classB = classB;
+        this.parameterA = parameterA;
+        this.parameterB = parameterB;
+    }
+
+    protected Either<A, B> parse(String input, CommandContext context) throws CommandParseException {
+        if (input == null) {
+            return null;
+        }
+        try {
+            return new Either<>(this.classA, this.classB, this.parameterA.parse(input, context));
+        } catch (Exception eA) {
+            try {
+                return new Either<>(this.classA, this.classB, this.parameterB.parse(input, context));
+            } catch (Exception eB) {
+                return null;
+            }
+        }
+    }
+
+    public List<String> getAutocompleteOptions(CommandContext context, String baseArgument, String query) {
+        return Stream.concat(
+                this.parameterA.getAutocompleteOptions(context, baseArgument, query).stream(),
+                this.parameterB.getAutocompleteOptions(context, baseArgument, query).stream()
+        ).collect(Collectors.toList());
+    }
+}
